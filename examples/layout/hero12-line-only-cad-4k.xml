<layout>
    <!-- Hero12 default + cadence: moving line-only map (no basemap) -->
    <translate x="2750" y="120">
        <component type="moving_journey_map"
                   size="920"
                   zoom="15"
                   rotate="true"
                   line-only="true"
                   line-rgb="255,255,255,255"
                   line-width="9"
                   loc-fill="45,120,255,255"
                   loc-size="9" />
    </translate>

    <component type="metric" x="760" y="720" metric="speed" units="kph" dp="0" size="300" align="right" rgb="255,255,255"/>
    <component type="metric_unit" x="790" y="825" metric="speed" units="kph" size="104" rgb="255,255,255">{:~c}</component>

    <component type="metric" x="730" y="1120" metric="power" units="watt" dp="0" size="230" align="right" rgb="255,255,255"/>
    <component type="metric_unit" x="760" y="1200" metric="power" units="watt" size="90" rgb="255,255,255">{:~c}</component>

    <component type="metric" x="730" y="1450" metric="cadence" units="rpm" dp="0" size="210" align="right" rgb="255,255,255"/>
    <component type="metric_unit" x="760" y="1525" metric="cadence" units="rpm" size="84" rgb="255,255,255">{:~c}</component>
</layout>
