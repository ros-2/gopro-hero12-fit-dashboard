<layout>
    <!-- Hero12 + HR: moving line-only map (no basemap) -->
    <translate x="2750" y="120">
        <component type="moving_journey_map"
                   size="920"
                   zoom="15"
                   rotate="true"
                   line-only="true"
                   line-rgb="255,255,255,255"
                   line-width="9"
                   loc-fill="45,120,255,255"
                   loc-size="9" />
    </translate>

    <component type="metric" x="700" y="690" metric="speed" units="kph" dp="0" size="300" align="right" rgb="255,255,255"/>
    <component type="metric_unit" x="730" y="795" metric="speed" units="kph" size="104" rgb="255,255,255">{:~c}</component>

    <component type="metric" x="680" y="1090" metric="power" units="watt" dp="0" size="230" align="right" rgb="255,255,255"/>
    <component type="metric_unit" x="710" y="1170" metric="power" units="watt" size="92" rgb="255,255,255">{:~c}</component>

    <component type="metric" x="680" y="1430" metric="hr" dp="0" size="210" align="right" rgb="255,255,255"/>
    <component type="text" x="710" y="1505" size="84" rgb="255,255,255">BPM</component>
</layout>
